# Скопируйте в .env и заполните. Файл .env не публикуйте.
NODE_ENV=production
PORT=3000
# Длинная случайная строка (минимум 32 символа): node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=
# Если сайт стоит за nginx/Caddy/Cloudflare, поставьте 1, чтобы лимиты считались по реальному IP клиента
TRUST_PROXY=1
DB_PATH=./data/kuka.db

# Номера администраторов через запятую. Только они попадут в /admin
ADMIN_PHONES=+77001234567
SUPPORT_PHONE=
CONTACT_EMAIL=you@example.com

# Откуда отправлять код в WhatsApp: console (только вывод в консоль, для проверки), greenapi или meta
OTP_PROVIDER=greenapi
# Green API (https://green-api.com): проще всего, работает с обычным номером WhatsApp
GREEN_ID=
GREEN_TOKEN=
# Meta WhatsApp Cloud API: официальный путь, нужен одобренный шаблон с кодом (категория Authentication)
WA_PHONE_NUMBER_ID=
WA_TOKEN=
WA_TEMPLATE=kuka_otp
WA_TEMPLATE_LANG=ru

# Только для локальной проверки: показывать код на экране (в production игнорируется)
DEV_EXPOSE_CODE=0
